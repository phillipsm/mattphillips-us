---
import BaseLayout from '../layouts/BaseLayout.astro';

const tiles = [
  {
    cls: 'dog-mode-tile',
    href: '/dog-mode',
    img: '/assets/dog-mode/dog-mode-tile@2x.jpg',
    alt: 'Dog Mode — illustrated cozy room scene with a happy dog under a glowing lamp',
    title: 'Dog Mode',
    desc: 'Give your dog control of their home — an iOS app and a paw-activated button that tunes your smart home to their preferences.',
  },
  {
    cls: 'mcp-tile',
    href: '/driftcheck',
    img: '/assets/driftcheck/driftcheck-tile@2x.png',
    alt: 'DriftCheck — grid with one drifted element highlighted',
    title: 'DriftCheck',
    desc: 'An open-source MCP server that helps AI coding assistants catch styling drift as a React Native app evolves.',
  },
  {
    cls: 'perma-tile',
    href: '/perma',
    img: '/assets/perma/perma-case-study-tile@2x.png',
    alt: 'Perma.cc logo',
    title: 'Perma.cc',
    desc: 'A web service used by courts, scholars, and journals to create permanent records of cited web sources.',
  },
  {
    cls: 'openbooth-tile',
    href: '/openbooth',
    img: '/assets/openbooth/openbooth-tile@2x.jpg',
    alt: 'OpenBooth phone booth',
    title: 'OpenBooth',
    desc: 'A piece of occupiable furniture — a phone booth for open offices and libraries.',
  },
  {
    cls: 'stereo-cam-tile',
    href: '/stereo-cam',
    img: '/assets/stereo-cam/stereo-cam-tile@2x.jpg',
    alt: 'Stereoscopic camera prototype',
    title: 'Stereoscopic Camera',
    desc: 'A four-lens digital camera built around an Arduino — capturing parallax-rich animated GIFs of ordinary scenes.',
  },
  {
    cls: 'older-tile',
    href: '/older-work',
    img: '/assets/drawing-algos/drawing-algos-tile@2x.png',
    alt: 'Generative pattern — older work',
    title: 'Older Work',
    desc: 'A grab bag of smaller pieces — generative visuals, an ambient timer, and hand-drawn illustrations.',
  },
];
---
<BaseLayout title="Matt Phillips — Design Engineer" bodyClass="port-landing">
  <div class="container">
    <div class="about-img">
      <img src="/assets/images/double-exposure-still-low-opacity.webp" alt="" width="1000" height="1000" />
    </div>

    <div class="intro-text">
      <p>Hello!</p>
      <p class="end-element">
        I'm a computer scientist and designer currently working as a
        Design Engineer at <a href="https://www.mooncreativelab.com/" target="_blank" rel="noopener">Moon Creative Lab</a>
        in Palo Alto, California.
      </p>
    </div>

    <div id="work" class="work-text">
      <h2 class="section-title">Work</h2>
      <p class="end-element">
        Software, physical products, and a few things in between.
      </p>
    </div>

    {tiles.map(t => (
      <div class={`${t.cls} tile`}>
        <a href={t.href} class="tile-link">
          <img src={t.img} alt={t.alt} width="2200" height="1600" loading="lazy" />
        </a>
        <p class="tile-title"><a href={t.href}>{t.title}</a></p>
        <p>{t.desc}</p>
      </div>
    ))}

    <div id="about" class="about-desc">
      <h2 class="title section-title">About</h2>
      <p>
        As a Design Engineer at
        <a href="https://www.mooncreativelab.com/" target="_blank" rel="noopener">Moon Creative Lab</a>,
        I build across mobile, web, systems, and physical objects. I arrived from
        Public Good Studio —
        a studio I founded. Prior to PGS, I spent several formative years in the
        <a href="https://lil.law.harvard.edu/" target="_blank" rel="noopener">Harvard Library Innovation Lab</a>.
      </p>
      <p>
        I received a BS in CS in 2002 from Mansfield University of Pennsylvania
        and in 2005 I received an MS in CS from Virginia Tech for my research in
        the Digital Libraries Research Lab and my coursework in HCI.
      </p>
      <p class="end-element">
        Bicycles, computers, and the Santa Cruz Mountains consume most of my
        thoughts.
      </p>
    </div>

    <div id="contact" class="contact-desc">
      <h2 class="section-title">Contact</h2>
      <p>
        I live in Palo Alto, California and actively use
        <a href="https://github.com/phillipsm" target="_blank" rel="noopener">GitHub</a> and
        <a href="https://www.instagram.com/this_phillips/" target="_blank" rel="noopener">Instagram</a>.
      </p>
      <p class="end-element">
        Email me at <a href="mailto:matt@mattphillips.us">matt@mattphillips.us</a> to chat about opportunities and collaborations.
      </p>
    </div>
  </div>
</BaseLayout>
