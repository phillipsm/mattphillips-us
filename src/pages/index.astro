---
import BaseLayout from '../layouts/BaseLayout.astro';

const tiles = [
  {
    cls: 'perma-tile',
    href: '/perma',
    img: 'https://placehold.co/600x400/2d2b26/fff?text=Project+1',
    alt: 'Project 1 placeholder',
    title: 'Project One',
    desc: 'A short description of this project — what was made, the context, and the role played.',
    roles: 'Interaction Designer. Full Stack Developer.',
  },
  {
    cls: 'algo-tile',
    href: '/drawing-algos',
    img: 'https://placehold.co/600x400/ee2348/fff?text=Project+2',
    alt: 'Project 2 placeholder',
    title: 'Project Two',
    desc: 'A short description of this project — what was made, the context, and the role played.',
    roles: 'JavaScript Developer.',
  },
  {
    cls: 'openbooth-tile',
    href: '/openbooth',
    img: 'https://placehold.co/600x400/2d2b26/fff?text=Project+3',
    alt: 'Project 3 placeholder',
    title: 'Project Three',
    desc: 'A short description of this project — what was made, the context, and the role played.',
    roles: 'Product Designer. Industrial Designer.',
  },
  {
    cls: 'illustration-tile',
    href: '/illustrations',
    img: 'https://placehold.co/600x400/ee2348/fff?text=Project+4',
    alt: 'Project 4 placeholder',
    title: 'Project Four',
    desc: 'A short description of this project — what was made, the context, and the role played.',
    roles: 'Illustrator. Graphic Designer.',
  },
];
---
<BaseLayout title="Matt Phillips" bodyClass="port-landing">
  <div class="container">
    <div class="about-img">
      <img src="/assets/images/double-exposure-still-low-opacity.gif" alt="" />
    </div>

    <div class="intro-text">
      <p>Hello!</p>
      <p class="end-element">
        I'm a computer scientist and interaction designer currently working as a
        senior engineer at <a href="https://www.mooncreativelab.com/">Moon Creative Lab</a>
        in Palo Alto, California.
      </p>
    </div>

    <div id="work" class="work-text">
      <h2 class="section-title">Work</h2>
      <p class="end-element">
        Listed here, you'll find examples of work I've produced — a broad selection
        of sketches, visual assets, technical explorations, code and prototypes.
      </p>
    </div>

    {tiles.map(t => (
      <div class={`${t.cls} tile`}>
        <a href={t.href} class="tile-link">
          <img src={t.img} alt={t.alt} />
        </a>
        <p class="tile-title"><a href={t.href}>{t.title}</a></p>
        <p>{t.desc}</p>
        <p class="tile-desc">{t.roles}</p>
      </div>
    ))}

    <div id="about" class="about-desc">
      <h2 class="title section-title">About</h2>
      <p>
        I'm excited to explore new ways of thinking and doing at the intersection
        of human factors and technology — I hope to setup outposts in recently
        charted lands.
      </p>
      <p>
        I currently write software as a multi-disciplinary, senior engineer at
        <a href="https://www.mooncreativelab.com/" target="_blank">Moon Creative Lab</a>
        in Palo Alto, California. I arrived at Moon from
        <a href="https://publicgood.studio/" target="_blank">Public Good Studio</a> —
        a studio I founded. Prior to PGS, I spent much of the last decade in the
        <a href="https://lil.law.harvard.edu/" target="_blank">Harvard Library Innovation Lab</a>.
      </p>
      <p>
        I received a BS in CS in 2002 from Mansfield University of Pennsylvania
        and in 2005 I received a MS in CS from Virginia Tech for my research in
        the Digital Libraries Research Lab and my coursework in HCI.
      </p>
      <p class="end-element">
        Bicycles, computers, horseplay, style and libraries consume most of my
        thoughts.
      </p>
    </div>

    <div id="contact" class="contact-desc">
      <h2 class="section-title">Contact</h2>
      <p>
        I live in Menlo Park, California and actively use
        <a href="https://github.com/phillipsm" target="_blank">GitHub</a> and
        <a href="https://www.instagram.com/this_phillips/" target="_blank">Instagram</a>.
      </p>
      <p>
        Drop me an email at <a href="mailto:matt@mattphillips.us">matt@mattphillips.us</a>.
      </p>
    </div>
  </div>
</BaseLayout>
