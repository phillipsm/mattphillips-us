---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  frontmatter?: { title?: string; description?: string; ogImage?: string; bodyClass?: string };
}
const { title, description, ogImage, frontmatter } = Astro.props;
const bodyClass = Astro.props.bodyClass ?? frontmatter?.bodyClass;

const DEFAULT_TITLE = 'Matt Phillips';
const DEFAULT_DESCRIPTION =
  'Matt Phillips — computer scientist and designer. Currently a Senior Design Engineer at Moon Creative Lab in Palo Alto, California. Work spans iOS apps, web services, and physical objects.';
const DEFAULT_OG_IMAGE = '/og-image.jpg';

const pageTitle = title ?? frontmatter?.title ?? DEFAULT_TITLE;
const pageDescription = description ?? frontmatter?.description ?? DEFAULT_DESCRIPTION;
const pageOgImage = ogImage ?? frontmatter?.ogImage ?? DEFAULT_OG_IMAGE;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(pageOgImage, Astro.site).toString();
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link rel="icon" href="/assets/images/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/assets/images/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/assets/images/favicon-180.png" />
    <meta name="msapplication-TileImage" content="/assets/images/favicon-270.png" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Matt Phillips" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preload" href="/assets/fonts/GT-Walsheim-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/GT-Walsheim-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class={bodyClass}>
    <header>
      <div class="nav-container">
        <div class="site-title">
          <h1><a href="/">Matt Phillips</a></h1>
        </div>
        <div class="main-nav">
          <nav>
            <ul>
              <li><p><a href="/#work">Work</a></p></li>
              <li><p><a href="/#about">About</a></p></li>
              <li><p><a href="/#contact">Contact</a></p></li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <slot />

    <footer>
      <div class="nav-container">
        <div class="site-title"></div>
        <div class="main-nav">
          <nav>
            <ul>
              <li><p><a href="/#work">Work</a></p></li>
              <li><p><a href="/#about">About</a></p></li>
              <li><p><a href="/#contact">Contact</a></p></li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "8f33be443a754de280a110e835a67701"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
